HOST=0.0.0.0
PORT=8080
DATA_DIR=/var/lib/guangya-sync/data
GUANGYA_ADMIN_USERNAME=admin
GUANGYA_ADMIN_PASSWORD=
GUANGYA_TRUST_PROXY=false
GUANGYA_HEADERS_TIMEOUT_MS=15000
GUANGYA_REQUEST_TIMEOUT_MS=30000
GUANGYA_WATCH_ROOT=/var/lib/guangya-sync/watch
GUANGYA_ARCHIVE_ROOT=/var/lib/guangya-sync/archive
GUANGYA_FILE_ROOTS=/var/lib/guangya-sync/watch,/var/lib/guangya-sync/archive
GUANGYA_RCLONE_PATH=/opt/guangya-sync/bin/rclone
GUANGYA_NATIVE_MOUNT_TARGET=/var/lib/guangya-sync/mount
GUANGYA_OSS_TIMEOUT_MS=600000
GUANGYA_OSS_RETRY_MAX=3
GUANGYA_OSS_PARALLEL=3
GUANGYA_CLOUD_CONFIRM_TIMEOUT_MS=600000
GUANGYA_CLOUD_CONFIRM_POLL_MS=1000
GUANGYA_AUTO_SHARE_QUIET_MS=30000
HDHIVE_BASE_URL=
HDHIVE_GUANGYA_SYNC_SECRET=
HDHIVE_GUANGYA_SYNC_INSTANCE_ID=
GUANGYA_TOKEN=
