{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "光鸭文件夹同步",
  "version": "0.1.27",
  "identifier": "com.hackguangya.folder-sync",
  "build": {
    "beforeDevCommand": "pnpm prepare:rclone && pnpm ui:dev",
    "beforeBuildCommand": "pnpm prepare:rclone && pnpm ui:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "光鸭文件夹同步",
        "width": 1040,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["nsis"],
    "resources": [
      "resources/rclone*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4OTdFODlCRTAyMkJCRjYKUldUMnV5TGdtK2lYS09wL0dZcTRYaG15N1ZHUWJoM1V4Wk9tODAvZ3hkUmlBcW02U20xNmp2VUoK",
      "endpoints": [
        "https://github.com/my-name-is-alan/hack-guangya/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
