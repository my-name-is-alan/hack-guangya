{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "光鸭文件夹同步",
  "version": "0.1.16",
  "identifier": "com.hackguangya.folder-sync",
  "build": {
    "beforeDevCommand": "pnpm prepare:rclone && pnpm ui:dev",
    "beforeBuildCommand": "pnpm prepare:rclone && pnpm ui:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; frame-src 'self' https://guangyapan.com https://*.guangyapan.com"
    },
    "windows": [
      {
        "label": "main",
        "title": "光鸭文件夹同步",
        "width": 1040,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["nsis"],
    "resources": [
      "resources/rclone*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
