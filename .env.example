# Docker Web：复制为 .env 后填写。不要提交真实密码、Token 或 HDHive 密钥。
GUANGYA_IMAGE=94xhzy/guangya-sync:0.1.32
GUANGYA_HTTP_PORT=8080
GUANGYA_ADMIN_USERNAME=admin
GUANGYA_ADMIN_PASSWORD=

# WebDAV 使用独立端口和独立凭据。Compose 只把该端口发布到宿主机 127.0.0.1。
# 密码可留空，启动后在“设置 → 挂载”中设置；这里的值只用于首次初始化。
GUANGYA_WEBDAV_PORT=19090
GUANGYA_WEBDAV_USERNAME=guangya
GUANGYA_WEBDAV_PASSWORD=

# 仅 Linux Docker 原生/FUSE 挂载覆盖文件使用；默认 Compose 不授予 /dev/fuse。
GUANGYA_NATIVE_MOUNT_ROOT=./mount

# 可留空，启动后在网页中扫码或验证码登录。
GUANGYA_TOKEN=

# 官方开发者 TOKEN 上传接口。可留空，之后在“设置 → 账号 → 开发者模式”中填写。
# 环境变量只托管凭据，仍需登录 client_id 所属账号并完成所有权验证后才能开启模式。
# 接收小号的 TOKEN 只在设置页添加，不要提交到 .env.example。
GUANGYA_DEVELOPER_CLIENT_ID=
GUANGYA_DEVELOPER_CLIENT_SECRET=

# 光鸭原生云盘媒体识别整理（仅同一云盘 A → B，不使用本地路径）。API Key 与 Read Access Token 二选一，也可启动后在“整理”页面配置。
# 环境变量优先于 SQLite 中保存的设置，密钥不会通过状态接口回显。
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_LANGUAGE=zh-CN
TMDB_IMAGE_LANGUAGE=zh,null,en
# 可选镜像；留空时使用 TMDB 官方地址，也可在“设置 → 整理与刮削 → TMDB 配置”中保存
TMDB_API_BASE=
TMDB_IMAGE_BASE=

# HDHive 可全部留空，之后也能在“设置 → HDHive”中配置。
HDHIVE_BASE_URL=
HDHIVE_GUANGYA_SYNC_SECRET=
HDHIVE_GUANGYA_SYNC_INSTANCE_ID=
HDHIVE_ALLOWED_HOSTS=

# 上传、下载和自动分享。
GUANGYA_UPLOAD_CONCURRENCY=2
GUANGYA_DOWNLOAD_CONCURRENCY=2
GUANGYA_OSS_TIMEOUT_MS=600000
GUANGYA_OSS_RETRY_MAX=3
GUANGYA_OSS_PARALLEL=3
GUANGYA_CLOUD_CONFIRM_TIMEOUT_MS=600000
GUANGYA_CLOUD_CONFIRM_POLL_MS=1000
GUANGYA_AUTO_SHARE_QUIET_MS=30000
GUANGYA_TOKEN_REFRESH_MS=1200000
GUANGYA_FILE_STABILITY_MS=1200
GUANGYA_FILE_BUSY_RETRY_MS=3000
